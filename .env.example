# Optional LLM API keys. Do not commit a real .env file.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Hosted demo protection. Leave DEMO_ACCESS_CODE empty only for local development.
DEMO_ACCESS_CODE=
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
ENABLE_DOCS=true

# Disabled by default so browser clients cannot choose or submit provider secrets.
ALLOW_CLIENT_API_KEYS=false

# Optional model overrides.
OPENROUTER_MODEL=openrouter/free
OPENAI_MODEL=gpt-4.1
GEMINI_MODEL=gemini-3.5-flash
GROQ_MODEL=llama-3.3-70b-versatile
